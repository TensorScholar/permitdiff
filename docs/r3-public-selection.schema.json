{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://permitdiff.dev/schemas/r3-public-selection.schema.json",
  "title": "PermitDiff R3 Public Historical Selection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_version",
    "protocol_version",
    "source_ledger_sha256",
    "target_cases",
    "max_cases_per_repository",
    "eligible_case_count",
    "selected_case_count",
    "shortfall",
    "selected"
  ],
  "properties": {
    "schema_version": {"const": "permitdiff.dev/r3-public-selection/v1"},
    "plan_version": {"const": "r3-exploratory-corpus-plan-v1"},
    "protocol_version": {"const": "r3-benchmark-protocol-v1"},
    "source_ledger_sha256": {"$ref": "#/$defs/sha256"},
    "target_cases": {"type": "integer", "minimum": 1},
    "max_cases_per_repository": {"type": "integer", "minimum": 1},
    "eligible_case_count": {"type": "integer", "minimum": 0},
    "selected_case_count": {"type": "integer", "minimum": 0},
    "shortfall": {"type": "integer", "minimum": 0},
    "selected": {
      "type": "array",
      "items": {"$ref": "#/$defs/selectedCase"}
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selectedCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "transition_id",
        "repository_full_name",
        "repository_url",
        "path",
        "baseline_commit",
        "candidate_commit",
        "baseline_blob",
        "candidate_blob",
        "baseline_sha256",
        "candidate_sha256",
        "selection_key"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "transition_id": {"type": "string", "pattern": "^gh-[0-9a-f]{20}$"},
        "repository_full_name": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "repository_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+$"
        },
        "path": {"enum": [".claude/settings.json", ".claude/settings.local.json"]},
        "baseline_commit": {"$ref": "#/$defs/sha1"},
        "candidate_commit": {"$ref": "#/$defs/sha1"},
        "baseline_blob": {"$ref": "#/$defs/sha1"},
        "candidate_blob": {"$ref": "#/$defs/sha1"},
        "baseline_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_sha256": {"$ref": "#/$defs/sha256"},
        "selection_key": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
