{
  "$defs": {
    "selectedCase": {
      "additionalProperties": false,
      "properties": {
        "baseline_blob": {
          "$ref": "#/$defs/sha1"
        },
        "baseline_commit": {
          "$ref": "#/$defs/sha1"
        },
        "baseline_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "candidate_blob": {
          "$ref": "#/$defs/sha1"
        },
        "candidate_commit": {
          "$ref": "#/$defs/sha1"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "path": {
          "enum": [
            ".claude/settings.json",
            ".claude/settings.local.json"
          ]
        },
        "rank": {
          "minimum": 1,
          "type": "integer"
        },
        "repository_full_name": {
          "pattern": "^[^/]+/[^/]+$",
          "type": "string"
        },
        "repository_url": {
          "pattern": "^https://github\\.com/[^/]+/[^/]+$",
          "type": "string"
        },
        "selection_key": {
          "$ref": "#/$defs/sha256"
        },
        "transition_id": {
          "pattern": "^gh-[0-9a-f]{20}$",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "transition_id",
        "repository_full_name",
        "repository_url",
        "path",
        "baseline_commit",
        "candidate_commit",
        "baseline_blob",
        "candidate_blob",
        "baseline_sha256",
        "candidate_sha256",
        "selection_key"
      ],
      "type": "object"
    },
    "sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://permitdiff.dev/schemas/r3-public-selection-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cap_admissible_count": {
      "minimum": 0,
      "type": "integer"
    },
    "cb01_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cb01_contract_version": {
      "const": "r3-cb01-corpus-construction-v1"
    },
    "maximum_cases_per_repository": {
      "const": 2
    },
    "minimum_viable_case_count": {
      "const": 12
    },
    "plan_version": {
      "const": "r3-exploratory-corpus-plan-v1"
    },
    "protocol_version": {
      "const": "r3-benchmark-protocol-v1"
    },
    "raw_eligible_count": {
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": "permitdiff.dev/r3-public-selection/v2"
    },
    "selected": {
      "items": {
        "$ref": "#/$defs/selectedCase"
      },
      "type": "array"
    },
    "selected_case_count": {
      "minimum": 0,
      "type": "integer"
    },
    "shortfall": {
      "minimum": 0,
      "type": "integer"
    },
    "source_screened_ledger_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "study_repository_commit": {
      "$ref": "#/$defs/sha1"
    },
    "target_case_count": {
      "const": 18
    }
  },
  "required": [
    "schema_version",
    "plan_version",
    "protocol_version",
    "cb01_contract_version",
    "cb01_contract_sha256",
    "study_repository_commit",
    "source_screened_ledger_sha256",
    "target_case_count",
    "maximum_cases_per_repository",
    "minimum_viable_case_count",
    "raw_eligible_count",
    "cap_admissible_count",
    "selected_case_count",
    "shortfall",
    "selected"
  ],
  "title": "PermitDiff R3 Public Historical Selection v2",
  "type": "object"
}
