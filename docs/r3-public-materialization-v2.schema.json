{
  "$defs": {
    "artifact": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^cases/gh-[0-9a-f]{20}/(baseline|candidate)\\.json$",
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "source_blob": {
          "$ref": "#/$defs/sha1"
        },
        "source_commit": {
          "$ref": "#/$defs/sha1"
        },
        "source_url": {
          "format": "uri",
          "pattern": "^https://github\\.com/",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "source_url",
        "source_commit",
        "source_blob",
        "size_bytes"
      ],
      "type": "object"
    },
    "case": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "$ref": "#/$defs/artifact"
        },
        "candidate": {
          "$ref": "#/$defs/artifact"
        },
        "rank": {
          "minimum": 1,
          "type": "integer"
        },
        "repository_full_name": {
          "pattern": "^[^/]+/[^/]+$",
          "type": "string"
        },
        "repository_url": {
          "pattern": "^https://github\\.com/[^/]+/[^/]+$",
          "type": "string"
        },
        "selection_key": {
          "$ref": "#/$defs/sha256"
        },
        "source_path": {
          "enum": [
            ".claude/settings.json",
            ".claude/settings.local.json"
          ]
        },
        "transition_id": {
          "pattern": "^gh-[0-9a-f]{20}$",
          "type": "string"
        }
      },
      "required": [
        "rank",
        "transition_id",
        "repository_full_name",
        "repository_url",
        "source_path",
        "selection_key",
        "baseline",
        "candidate"
      ],
      "type": "object"
    },
    "sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://permitdiff.dev/schemas/r3-public-materialization-v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Exact vendored artifacts for a frozen R3 public historical selection (CB-01 v2 bindings).",
  "properties": {
    "cases": {
      "items": {
        "$ref": "#/$defs/case"
      },
      "type": "array"
    },
    "generated_at": {
      "format": "date-time",
      "type": "string"
    },
    "plan_version": {
      "const": "r3-exploratory-corpus-plan-v1"
    },
    "protocol_version": {
      "const": "r3-benchmark-protocol-v1"
    },
    "schema_version": {
      "const": "permitdiff.dev/r3-public-materialization/v2"
    },
    "selected_case_count": {
      "minimum": 0,
      "type": "integer"
    },
    "source_cb01_lineage_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_selection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "study_repository_commit": {
      "$ref": "#/$defs/sha1"
    }
  },
  "required": [
    "schema_version",
    "plan_version",
    "protocol_version",
    "source_selection_sha256",
    "source_cb01_lineage_sha256",
    "study_repository_commit",
    "generated_at",
    "selected_case_count",
    "cases"
  ],
  "title": "PermitDiff R3 Public Historical Materialization v2",
  "type": "object"
}
