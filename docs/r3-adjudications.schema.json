{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://permitdiff.dev/schemas/r3-adjudications.schema.json",
  "title": "PermitDiff R3 Output-Blind Adjudications",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_version",
    "protocol_version",
    "source_review_packet_set_sha256",
    "generated_at",
    "product_output_consulted",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "permitdiff.dev/r3-adjudications/v1"},
    "plan_version": {"const": "r3-exploratory-corpus-plan-v1"},
    "protocol_version": {"const": "r3-benchmark-protocol-v1"},
    "source_review_packet_set_sha256": {"$ref": "#/$defs/sha256"},
    "generated_at": {"type": "string", "format": "date-time"},
    "product_output_consulted": {"const": false},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "transition_id",
        "status",
        "label",
        "support_boundary",
        "review_status",
        "reviewers",
        "rationale",
        "atomic_categories",
        "evidence_refs",
        "ambiguity_notes",
        "change_family"
      ],
      "properties": {
        "rank": {"type": "integer", "minimum": 1},
        "transition_id": {"type": "string", "pattern": "^gh-[0-9a-f]{20}$"},
        "status": {"enum": ["pending", "decided"]},
        "label": {
          "type": ["string", "null"],
          "enum": [
            "SECURITY_RELEVANT_REGRESSION",
            "BENIGN_OR_RESTRICTIVE_CHANGE",
            "UNKNOWN_OR_UNSUPPORTED",
            null
          ]
        },
        "support_boundary": {
          "type": ["string", "null"],
          "enum": ["supported", "unsupported_or_unknown", null]
        },
        "review_status": {
          "type": ["string", "null"],
          "enum": ["single_reviewed", "double_reviewed", "adjudicated", null]
        },
        "reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "rationale": {"type": ["string", "null"], "maxLength": 10000},
        "atomic_categories": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "ambiguity_notes": {"type": ["string", "null"], "maxLength": 4000},
        "change_family": {"type": ["string", "null"], "maxLength": 128}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "decided"}}, "required": ["status"]},
          "then": {
            "properties": {
              "label": {"type": "string"},
              "support_boundary": {"type": "string"},
              "review_status": {"type": "string"},
              "reviewers": {"minItems": 1},
              "rationale": {"type": "string", "minLength": 1},
              "evidence_refs": {"minItems": 1},
              "change_family": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"label": {"const": "SECURITY_RELEVANT_REGRESSION"}},
            "required": ["label"]
          },
          "then": {"properties": {"atomic_categories": {"minItems": 1}}}
        }
      ]
    }
  }
}
