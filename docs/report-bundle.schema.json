{
  "$defs": {
    "AuthorityFinding": {
      "additionalProperties": false,
      "description": "One deterministic static finding about a policy change.",
      "properties": {
        "baseline_effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionEffect"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Rule Id"
        },
        "candidate_effect": {
          "anyOf": [
            {
              "$ref": "#/$defs/DecisionEffect"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Rule Id"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AuthorityFindingKind"
        },
        "match_relation": {
          "anyOf": [
            {
              "$ref": "#/$defs/MatchRelation"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "fingerprint",
        "kind",
        "code",
        "baseline_rule_id",
        "candidate_rule_id",
        "baseline_effect",
        "candidate_effect",
        "match_relation",
        "message"
      ],
      "title": "AuthorityFinding",
      "type": "object"
    },
    "AuthorityFindingKind": {
      "description": "Gate-relevant conclusion from bounded static analysis.",
      "enum": [
        "potential_expansion",
        "unknown"
      ],
      "title": "AuthorityFindingKind",
      "type": "string"
    },
    "ChangeDirection": {
      "description": "Whether candidate policy semantics expand or restrict permissions.",
      "enum": [
        "unchanged",
        "expanded",
        "restricted"
      ],
      "title": "ChangeDirection",
      "type": "string"
    },
    "ComparisonReport": {
      "additionalProperties": false,
      "description": "Complete deterministic comparison artifact.",
      "properties": {
        "authority_findings": {
          "items": {
            "$ref": "#/$defs/AuthorityFinding"
          },
          "title": "Authority Findings",
          "type": "array"
        },
        "baseline_coverage": {
          "$ref": "#/$defs/RuleCoverage"
        },
        "baseline_digest": {
          "title": "Baseline Digest",
          "type": "string"
        },
        "baseline_name": {
          "title": "Baseline Name",
          "type": "string"
        },
        "baseline_version": {
          "title": "Baseline Version",
          "type": "string"
        },
        "candidate_coverage": {
          "$ref": "#/$defs/RuleCoverage"
        },
        "candidate_digest": {
          "title": "Candidate Digest",
          "type": "string"
        },
        "candidate_name": {
          "title": "Candidate Name",
          "type": "string"
        },
        "candidate_version": {
          "title": "Candidate Version",
          "type": "string"
        },
        "corpus_digest": {
          "title": "Corpus Digest",
          "type": "string"
        },
        "schema_version": {
          "default": "permitdiff.report/v1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "structural_diff": {
          "$ref": "#/$defs/StructuralDiff"
        },
        "summary": {
          "$ref": "#/$defs/ComparisonSummary"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/ScenarioTransition"
          },
          "title": "Transitions",
          "type": "array"
        }
      },
      "required": [
        "baseline_name",
        "baseline_version",
        "baseline_digest",
        "candidate_name",
        "candidate_version",
        "candidate_digest",
        "corpus_digest",
        "summary",
        "structural_diff",
        "baseline_coverage",
        "candidate_coverage",
        "transitions",
        "authority_findings"
      ],
      "title": "ComparisonReport",
      "type": "object"
    },
    "ComparisonSummary": {
      "additionalProperties": false,
      "description": "Aggregate counts used by humans and release gates.",
      "properties": {
        "approval_bypasses": {
          "title": "Approval Bypasses",
          "type": "integer"
        },
        "changed_effects": {
          "title": "Changed Effects",
          "type": "integer"
        },
        "new_allows": {
          "title": "New Allows",
          "type": "integer"
        },
        "privilege_expansions": {
          "title": "Privilege Expansions",
          "type": "integer"
        },
        "restrictions": {
          "title": "Restrictions",
          "type": "integer"
        },
        "scenarios": {
          "title": "Scenarios",
          "type": "integer"
        },
        "static_authority_expansions": {
          "title": "Static Authority Expansions",
          "type": "integer"
        },
        "static_authority_unknowns": {
          "title": "Static Authority Unknowns",
          "type": "integer"
        },
        "unchanged_effects": {
          "title": "Unchanged Effects",
          "type": "integer"
        }
      },
      "required": [
        "scenarios",
        "unchanged_effects",
        "changed_effects",
        "privilege_expansions",
        "restrictions",
        "new_allows",
        "approval_bypasses",
        "static_authority_expansions",
        "static_authority_unknowns"
      ],
      "title": "ComparisonSummary",
      "type": "object"
    },
    "DecisionEffect": {
      "description": "Ordered authorization outcomes from least to most permissive.",
      "enum": [
        "deny",
        "require_approval",
        "allow"
      ],
      "title": "DecisionEffect",
      "type": "string"
    },
    "GateResult": {
      "additionalProperties": false,
      "description": "Machine-readable release verdict.",
      "properties": {
        "expired_waivers": {
          "items": {
            "type": "string"
          },
          "title": "Expired Waivers",
          "type": "array"
        },
        "missing_differential_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Missing Differential Evidence",
          "type": "array"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "schema_version": {
          "default": "permitdiff.gate-result/v1alpha1",
          "title": "Schema Version",
          "type": "string"
        },
        "unused_waivers": {
          "items": {
            "type": "string"
          },
          "title": "Unused Waivers",
          "type": "array"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/GateViolation"
          },
          "title": "Violations",
          "type": "array"
        },
        "waived_authority_findings": {
          "items": {
            "type": "string"
          },
          "title": "Waived Authority Findings",
          "type": "array"
        },
        "waived_scenarios": {
          "items": {
            "type": "string"
          },
          "title": "Waived Scenarios",
          "type": "array"
        }
      },
      "required": [
        "passed",
        "violations",
        "waived_scenarios",
        "expired_waivers",
        "unused_waivers"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "GateViolation": {
      "additionalProperties": false,
      "description": "One failed release condition.",
      "properties": {
        "actual": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Actual"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Limit"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message",
        "actual",
        "limit"
      ],
      "title": "GateViolation",
      "type": "object"
    },
    "MatchRelation": {
      "description": "Conservative containment relation for candidate versus baseline match sets.",
      "enum": [
        "equal",
        "broader",
        "narrower",
        "incomparable",
        "unknown"
      ],
      "title": "MatchRelation",
      "type": "string"
    },
    "RiskLevel": {
      "description": "Scenario risk used for release reporting and gate severity.",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "RuleCoverage": {
      "additionalProperties": false,
      "description": "Observed rule hit counts for a policy over the corpus.",
      "properties": {
        "default_hits": {
          "title": "Default Hits",
          "type": "integer"
        },
        "rule_hits": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Rule Hits",
          "type": "object"
        },
        "uncovered_rules": {
          "items": {
            "type": "string"
          },
          "title": "Uncovered Rules",
          "type": "array"
        }
      },
      "required": [
        "rule_hits",
        "default_hits",
        "uncovered_rules"
      ],
      "title": "RuleCoverage",
      "type": "object"
    },
    "ScenarioTransition": {
      "additionalProperties": false,
      "description": "Baseline-to-candidate decision transition for one scenario.",
      "properties": {
        "action_fingerprint": {
          "title": "Action Fingerprint",
          "type": "string"
        },
        "baseline_effect": {
          "$ref": "#/$defs/DecisionEffect"
        },
        "baseline_rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Baseline Rule Id"
        },
        "candidate_effect": {
          "$ref": "#/$defs/DecisionEffect"
        },
        "candidate_rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Candidate Rule Id"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "direction": {
          "$ref": "#/$defs/ChangeDirection"
        },
        "owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel"
        },
        "scenario_id": {
          "title": "Scenario Id",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "scenario_id",
        "description",
        "owner",
        "tags",
        "risk",
        "action_fingerprint",
        "baseline_effect",
        "candidate_effect",
        "baseline_rule_id",
        "candidate_rule_id",
        "direction",
        "severity"
      ],
      "title": "ScenarioTransition",
      "type": "object"
    },
    "Severity": {
      "description": "Review severity assigned to a permission transition.",
      "enum": [
        "note",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "StructuralDiff": {
      "additionalProperties": false,
      "description": "Review-oriented structural changes between policy documents.",
      "properties": {
        "added_rules": {
          "items": {
            "type": "string"
          },
          "title": "Added Rules",
          "type": "array"
        },
        "baseline_default_effect": {
          "$ref": "#/$defs/DecisionEffect"
        },
        "candidate_default_effect": {
          "$ref": "#/$defs/DecisionEffect"
        },
        "default_effect_changed": {
          "title": "Default Effect Changed",
          "type": "boolean"
        },
        "modified_rules": {
          "items": {
            "type": "string"
          },
          "title": "Modified Rules",
          "type": "array"
        },
        "removed_rules": {
          "items": {
            "type": "string"
          },
          "title": "Removed Rules",
          "type": "array"
        },
        "reordered_rules": {
          "title": "Reordered Rules",
          "type": "boolean"
        }
      },
      "required": [
        "added_rules",
        "removed_rules",
        "modified_rules",
        "reordered_rules",
        "default_effect_changed",
        "baseline_default_effect",
        "candidate_default_effect"
      ],
      "title": "StructuralDiff",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Versioned JSON envelope for one comparison and optional gate result.",
  "properties": {
    "comparison": {
      "$ref": "#/$defs/ComparisonReport"
    },
    "gate": {
      "anyOf": [
        {
          "$ref": "#/$defs/GateResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "default": "permitdiff.bundle/v1alpha1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "comparison"
  ],
  "title": "ReportEnvelope",
  "type": "object"
}
