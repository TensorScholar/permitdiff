        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://permitdiff.dev/schemas/r3-execution-environment-lock.schema.json",
