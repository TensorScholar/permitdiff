{
  "$defs": {
    "sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://permitdiff.dev/schemas/r3-cb01-corpus-construction-lineage.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic technical integrity evidence for one CB-01 construction chain. Not authorization.",
  "properties": {
    "cap_admissible_count": {
      "minimum": 0,
      "type": "integer"
    },
    "cb01_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cb01_contract_version": {
      "const": "r3-cb01-corpus-construction-v1"
    },
    "maximum_cases_per_repository": {
      "const": 2
    },
    "minimum_viable_case_count": {
      "const": 12
    },
    "plan_version": {
      "const": "r3-exploratory-corpus-plan-v1"
    },
    "protocol_version": {
      "const": "r3-benchmark-protocol-v1"
    },
    "public_selection_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "raw_discovery_ledger_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "raw_eligible_count": {
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": "permitdiff.dev/r3-cb01-corpus-construction-lineage/v1"
    },
    "screened_discovery_ledger_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "screening_decisions_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "selected_case_count": {
      "minimum": 0,
      "type": "integer"
    },
    "shortfall": {
      "minimum": 0,
      "type": "integer"
    },
    "study_repository_commit": {
      "$ref": "#/$defs/sha1"
    },
    "target_case_count": {
      "const": 18
    }
  },
  "required": [
    "schema_version",
    "cb01_contract_version",
    "cb01_contract_sha256",
    "study_repository_commit",
    "plan_version",
    "protocol_version",
    "raw_discovery_ledger_sha256",
    "screening_decisions_sha256",
    "screened_discovery_ledger_sha256",
    "public_selection_sha256",
    "raw_eligible_count",
    "cap_admissible_count",
    "selected_case_count",
    "target_case_count",
    "maximum_cases_per_repository",
    "minimum_viable_case_count",
    "shortfall"
  ],
  "title": "PermitDiff R3 CB-01 Corpus-Construction Lineage",
  "type": "object"
}
