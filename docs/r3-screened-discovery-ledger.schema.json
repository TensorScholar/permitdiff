{
  "$defs": {
    "discoveryMarker": {
      "additionalProperties": false,
      "properties": {
        "candidate_path": {
          "enum": [
            ".claude/settings.json",
            ".claude/settings.local.json"
          ]
        },
        "query_id": {
          "enum": [
            "q1",
            "q2",
            "q3",
            "q4",
            "q5"
          ]
        }
      },
      "required": [
        "query_id",
        "candidate_path"
      ],
      "type": "object"
    },
    "exclusionReason": {
      "enum": [
        "unavailable_provenance",
        "ambiguous_parent_transition",
        "artifact_parse_failure",
        "no_authorization_relevant_change",
        "duplicate_transition",
        "insufficient_public_semantics",
        "private_or_sensitive_content",
        "non_project_or_unscoped_settings",
        "pre_exposed_engineering_control"
      ]
    },
    "nullableSha1": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha1"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableSha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "transition": {
      "additionalProperties": false,
      "properties": {
        "baseline_blob": {
          "$ref": "#/$defs/nullableSha1"
        },
        "baseline_commit": {
          "$ref": "#/$defs/sha1"
        },
        "baseline_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "baseline_size_bytes": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "candidate_blob": {
          "$ref": "#/$defs/nullableSha1"
        },
        "candidate_commit": {
          "$ref": "#/$defs/sha1"
        },
        "candidate_commit_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_parent_count": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "candidate_sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "candidate_size_bytes": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "contamination_status": {
          "enum": [
            "clean",
            "pre_exposed_engineering_control"
          ]
        },
        "discovered_by": {
          "items": {
            "$ref": "#/$defs/discoveryMarker"
          },
          "type": "array"
        },
        "exclusion_reasons": {
          "items": {
            "$ref": "#/$defs/exclusionReason"
          },
          "type": "array",
          "uniqueItems": true
        },
        "manual_review_required": {
          "const": false
        },
        "path": {
          "enum": [
            ".claude/settings.json",
            ".claude/settings.local.json"
          ]
        },
        "permissions_changed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "repository_full_name": {
          "pattern": "^[^/]+/[^/]+$",
          "type": "string"
        },
        "repository_url": {
          "pattern": "^https://github\\.com/[^/]+/[^/]+$",
          "type": "string"
        },
        "screening_status": {
          "enum": [
            "eligible",
            "excluded"
          ]
        },
        "selection_key": {
          "$ref": "#/$defs/sha256"
        },
        "transition_id": {
          "pattern": "^gh-[0-9a-f]{20}$",
          "type": "string"
        }
      },
      "required": [
        "transition_id",
        "discovered_by",
        "repository_full_name",
        "repository_url",
        "path",
        "baseline_commit",
        "candidate_commit",
        "baseline_blob",
        "candidate_blob",
        "baseline_sha256",
        "candidate_sha256",
        "baseline_size_bytes",
        "candidate_size_bytes",
        "candidate_commit_timestamp",
        "candidate_parent_count",
        "permissions_changed",
        "screening_status",
        "exclusion_reasons",
        "contamination_status",
        "selection_key",
        "manual_review_required"
      ],
      "type": "object"
    }
  },
  "$id": "https://permitdiff.dev/schemas/r3-screened-discovery-ledger.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cb01_contract_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cb01_contract_version": {
      "const": "r3-cb01-corpus-construction-v1"
    },
    "plan_version": {
      "const": "r3-exploratory-corpus-plan-v1"
    },
    "protocol_version": {
      "const": "r3-benchmark-protocol-v1"
    },
    "schema_version": {
      "const": "permitdiff.dev/r3-screened-discovery-ledger/v1"
    },
    "source_discovery_ledger_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "source_screening_decisions_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "study_repository_commit": {
      "$ref": "#/$defs/sha1"
    },
    "transition_count": {
      "minimum": 0,
      "type": "integer"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/transition"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "plan_version",
    "protocol_version",
    "cb01_contract_version",
    "cb01_contract_sha256",
    "study_repository_commit",
    "source_discovery_ledger_sha256",
    "source_screening_decisions_sha256",
    "transition_count",
    "transitions"
  ],
  "title": "PermitDiff R3 Screened Discovery Ledger",
  "type": "object"
}
