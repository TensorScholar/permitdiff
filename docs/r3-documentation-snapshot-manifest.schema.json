{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://permitdiff.dev/schemas/r3-documentation-snapshot-manifest.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","manifest_version","corpus_id","generated_at","documents","cases"],
  "properties":{
    "schema_version":{"const":"permitdiff.dev/r3-documentation-snapshot-manifest/v1"},
    "manifest_version":{"const":"r3-documentation-snapshots-v1"},
    "corpus_id":{"type":"string","minLength":1,"maxLength":128},
    "generated_at":{"type":"string","format":"date-time"},
    "documents":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/document"}},
    "cases":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/case"}}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "document":{
      "type":"object","additionalProperties":false,
      "required":["document_id","source_url","retrieved_at","snapshot_path","snapshot_sha256","content_type","format","normalization"],
      "properties":{
        "document_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
        "source_url":{"type":"string","format":"uri","pattern":"^https://"},
        "retrieved_at":{"type":"string","format":"date-time"},
        "snapshot_path":{"type":"string","minLength":1,"maxLength":1024},
        "snapshot_sha256":{"$ref":"#/$defs/sha256"},
        "content_type":{"type":"string","minLength":1,"maxLength":128},
        "format":{"enum":["text","html","markdown","json","pdf"]},
        "normalization":{"type":"string","minLength":1,"maxLength":1000}
      }
    },
    "case":{
      "type":"object","additionalProperties":false,
      "required":["case_id","documentation_ids","documentation_snapshot_set_sha256"],
      "properties":{
        "case_id":{"type":"string","minLength":1,"maxLength":128},
        "documentation_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
        "documentation_snapshot_set_sha256":{"$ref":"#/$defs/sha256"}
      }
    }
  }
}
