{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://permitdiff.dev/schemas/r3-discovery-ledger.schema.json",
  "title": "PermitDiff R3 Public Discovery Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_version",
    "protocol_version",
    "generated_at",
    "source",
    "discovery_complete",
    "limitations",
    "queries",
    "discovered_location_count",
    "transition_count",
    "transitions"
  ],
  "properties": {
    "schema_version": {"const": "permitdiff.dev/r3-discovery-ledger/v1"},
    "plan_version": {"const": "r3-exploratory-corpus-plan-v1"},
    "protocol_version": {"const": "r3-benchmark-protocol-v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {"const": "github-rest-code-search-and-commit-history"},
    "discovery_complete": {"type": "boolean"},
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "queries": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/queryEvidence"}
    },
    "discovered_location_count": {"type": "integer", "minimum": 0},
    "transition_count": {"type": "integer", "minimum": 0},
    "transitions": {
      "type": "array",
      "items": {"$ref": "#/$defs/transition"}
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha1": {
      "anyOf": [
        {"$ref": "#/$defs/sha1"},
        {"type": "null"}
      ]
    },
    "nullableSha256": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "queryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id",
        "concept",
        "candidate_path",
        "api_query",
        "reported_total_count",
        "retrieved_count",
        "exact_candidate_path_count",
        "incomplete_results",
        "api_result_cap_reached"
      ],
      "properties": {
        "query_id": {"enum": ["q1", "q2", "q3", "q4", "q5"]},
        "concept": {"type": "string", "minLength": 1},
        "candidate_path": {
          "enum": [".claude/settings.json", ".claude/settings.local.json"]
        },
        "api_query": {"type": "string", "minLength": 1},
        "reported_total_count": {"type": "integer", "minimum": 0},
        "retrieved_count": {"type": "integer", "minimum": 0, "maximum": 1000},
        "exact_candidate_path_count": {"type": "integer", "minimum": 0},
        "incomplete_results": {"type": "boolean"},
        "api_result_cap_reached": {"type": "boolean"}
      }
    },
    "discoveryMarker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "candidate_path"],
      "properties": {
        "query_id": {"enum": ["q1", "q2", "q3", "q4", "q5"]},
        "candidate_path": {
          "enum": [".claude/settings.json", ".claude/settings.local.json"]
        }
      }
    },
    "exclusionReason": {
      "enum": [
        "unavailable_provenance",
        "ambiguous_parent_transition",
        "artifact_parse_failure",
        "no_authorization_relevant_change",
        "duplicate_transition",
        "insufficient_public_semantics",
        "private_or_sensitive_content",
        "non_project_or_unscoped_settings",
        "pre_exposed_engineering_control"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transition_id",
        "discovered_by",
        "repository_full_name",
        "repository_url",
        "path",
        "baseline_commit",
        "candidate_commit",
        "baseline_blob",
        "candidate_blob",
        "baseline_sha256",
        "candidate_sha256",
        "baseline_size_bytes",
        "candidate_size_bytes",
        "candidate_commit_timestamp",
        "candidate_parent_count",
        "permissions_changed",
        "screening_status",
        "exclusion_reasons",
        "contamination_status",
        "selection_key",
        "manual_review_required"
      ],
      "properties": {
        "transition_id": {"type": "string", "pattern": "^gh-[0-9a-f]{20}$"},
        "discovered_by": {
          "type": "array",
          "items": {"$ref": "#/$defs/discoveryMarker"}
        },
        "repository_full_name": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
        "repository_url": {
          "type": "string",
          "pattern": "^https://github\\.com/[^/]+/[^/]+$"
        },
        "path": {"enum": [".claude/settings.json", ".claude/settings.local.json"]},
        "baseline_commit": {"$ref": "#/$defs/sha1"},
        "candidate_commit": {"$ref": "#/$defs/sha1"},
        "baseline_blob": {"$ref": "#/$defs/nullableSha1"},
        "candidate_blob": {"$ref": "#/$defs/nullableSha1"},
        "baseline_sha256": {"$ref": "#/$defs/nullableSha256"},
        "candidate_sha256": {"$ref": "#/$defs/nullableSha256"},
        "baseline_size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "candidate_size_bytes": {"type": ["integer", "null"], "minimum": 0},
        "candidate_commit_timestamp": {"type": ["string", "null"]},
        "candidate_parent_count": {"type": ["integer", "null"], "minimum": 0},
        "permissions_changed": {"type": ["boolean", "null"]},
        "screening_status": {"enum": ["pending", "eligible", "excluded"]},
        "exclusion_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/exclusionReason"}
        },
        "contamination_status": {
          "enum": ["clean", "pre_exposed_engineering_control"]
        },
        "selection_key": {"$ref": "#/$defs/sha256"},
        "manual_review_required": {"type": "boolean"}
      }
    }
  }
}
